+    fn kai_link_text(text:&str,highlights:&[(std::ops::Range<usize>,InlineStyle)])->String{
+        let mut rendered=text.to_owned();let mut spans=Vec::new();
+        for (range,style) in highlights {
+            if let InlineStyle::Link(target)=style {
+                if (target.starts_with("https://") || target.starts_with("http://") || target.starts_with('/'))
+                    && !target.contains(['"','\n','\r']) && range.start<range.end && range.end<=text.len()
+                    && text.is_char_boundary(range.start) && text.is_char_boundary(range.end){spans.push((range.clone(),target.clone()))}
+            }
+        }
+        spans.sort_by_key(|(range,_)|range.start);spans.dedup_by(|a,b|a.0==b.0);
+        let mut boundary=text.len();
+        for (range,target) in spans.into_iter().rev(){
+            if range.end<=boundary {rendered.replace_range(range.clone(),&format!(":codex-file-citation{{path=\"{target}\" purpose=\"output\"}}"));boundary=range.start}
+        }
+        rendered
+    }
